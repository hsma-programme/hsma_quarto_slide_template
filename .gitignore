/.quarto/
*.pyc
/.venv/

/.luarc.json

**/*.quarto_ipynb

# Jupyter engine intermediates. The rule above does not match the numbered
# variants (slides.quarto_ipynb_1, _2, ...) that Quarto leaves behind.
**/*.quarto_ipynb_*

_quarto_internal_scss_error.scss

# The freeze cache is a local build artefact -- it is rebuilt on render.
/_freeze/
/docs/_freeze/

# NOTE: do NOT add `docs/` here. It is the GitHub Pages source and must stay
# committable, otherwise every render's new content-hashed filenames get
# skipped by `git add -A` and you need `git add -f` forever.

# scratch output dir for single-section preview renders, e.g.
# quarto preview _SECTION_foo.qmd --output-dir _preview
_preview/

_SECTION_*.html

# Root-level only: the leading slashes matter. Unanchored, `slides_files/`
# also matches docs/slides_files/ and silently drops each render's new
# content-hashed theme CSS from commits, so the published deck loses its
# styling (theme 404s on GitHub Pages).
/_SECTION_*/
/slides_files/
